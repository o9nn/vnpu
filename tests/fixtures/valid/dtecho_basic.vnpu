// vNPU Test Fixture: DTEcho basic echo pattern
// (mirrors examples/dtecho_basic.vnpu)
vnpu v1;

device cpu0 { kind=cpu; threads=8; }
device gpu0 { kind=cuda; sm=86; }

tensor intent_vec   : f32[1,512]  @cpu0;
tensor branch_state : f32[1,1024] @gpu0;
tensor leaf_state   : f32[1,256]  @gpu0;
tensor evidence_vec : f32[1,512]  @cpu0;
tensor provenance   : f32[1,4]    @cpu0;

kernel k_encode   = dtecho.encode(intent_vec, provenance) -> branch_state;
kernel k_branch   = dtecho.branch(branch_state) -> leaf_state;
kernel k_compute  = dtecho.leaf(leaf_state) -> leaf_state;
kernel k_echo     = dtecho.echo(leaf_state, provenance) -> branch_state;
kernel k_decode   = dtecho.decode(branch_state) -> evidence_vec;

policy echo_policy {
  membrane inner denies toolcall;
  membrane inner denies external_io;
  membrane trans allows evidence when provenance >= 0.7;
  membrane trans allows intent when depth <= 8;
  membrane outer allows intent when budget.tokens <= 4096;
  membrane outer allows evidence when echo.complete == true;
}

graph g_leaf {
  k_compute;
}

graph g_branch {
  k_branch;
  k_echo;
}

graph g_coordinator {
  k_encode;
  k_decode;
}

isolate leaf_node {
  membrane=inner;
  entry g_leaf;
  ports {
    task_in: Intent;
    result_out: Evidence;
    state: Tensor;
  }
}

isolate branch_node {
  membrane=trans;
  entry g_branch;
  ports {
    parent_in: Intent;
    parent_out: Evidence;
    child_out: Intent;
    child_in: Evidence;
    control: Bytes;
  }
}

isolate echo_coordinator {
  membrane=outer;
  entry g_coordinator;
  ports {
    intent: Intent;
    evidence: Evidence;
    status: Tensor;
    control: Bytes;
  }
}
